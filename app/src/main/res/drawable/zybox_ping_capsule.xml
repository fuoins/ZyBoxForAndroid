<?xml version="1.0" encoding="utf-8"?>
<!-- ZyBox 6.0: 延迟显示胶囊（渐变底 + 淡描边，质感增强） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#E4EBFF"
        android:endColor="#D6E2FF" />
    <stroke
        android:width="1dp"
        android:color="#3A3D6BFF" />
    <corners android:radius="12dp" />
</shape>
