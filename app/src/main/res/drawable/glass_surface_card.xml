<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid Glass · 标准玻璃面
    渐变填充（顶亮底暗制造折射）+ 顶部镜面反光 + 一圈高光描边。
    用于 XML 直接引用的场景；Kotlin 侧 GlassSurfaceDrawable 提供更细腻的版本。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外描边（略深，模拟玻璃厚度） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_outer" />
            <corners android:radius="@dimen/glass_corner_card" />
        </shape>
    </item>

    <!-- 主填充：自上而下的折射渐变 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_surface_soft"
                android:startColor="@color/glass_surface_strong" />
            <corners android:radius="@dimen/glass_corner_card" />
        </shape>
    </item>

    <!-- 顶部镜面高光带 -->
    <item
        android:gravity="top"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <size android:height="28dp" />
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_highlight_soft" />
            <corners
                android:topLeftRadius="@dimen/glass_corner_card"
                android:topRightRadius="@dimen/glass_corner_card" />
        </shape>
    </item>

    <!-- 内侧亮边 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="@dimen/glass_corner_card" />
        </shape>
    </item>

</layer-list>
