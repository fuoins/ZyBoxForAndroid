<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: 主操作球（深墨玻璃球 + 顶部反光 + 底部阴影） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_accent_pressed"
                android:startColor="@color/glass_accent" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="oval">
            <size android:height="28dp" />
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_highlight_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
