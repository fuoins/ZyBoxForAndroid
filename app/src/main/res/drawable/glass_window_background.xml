<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid Glass · 窗口底层
    只铺一层冷银基底，光斑全部由 LiquidGlassBackdrop 在运行时绘制。
    早期版本在这里用 layer-list 摆过四个 oval 光源，但 layer-list 的
    gravity + size 在部分设备上会被拉伸成方形色块，正好压在悬浮工具栏背后，
    看起来像一块矩形背景，因此这里只保留纯色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_bg" />
</shape>
