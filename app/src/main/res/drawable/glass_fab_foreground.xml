<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid Glass: 主操作球（FAB）的玻璃质感层。
    FAB 会丢弃自定义 background，所以球体的顶光与棱边改由 foreground 叠在它自带的
    圆形 shape 之上，和界面其它玻璃面板保持同一套材质语言。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部反光：从上往下的白色渐隐 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_highlight_soft" />
        </shape>
    </item>
    <!-- 棱边：一圈 1dp 的玻璃高光 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
