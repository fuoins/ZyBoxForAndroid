<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid Glass · 弹出菜单
    与卡片不同，菜单下面压着正文，必须足够「实」，否则文字会互相穿插。
    这里用 97% 的实底玻璃，再叠顶部镜面高光与一圈内描边，
    背景模糊（API 31+，见 GlassPopupMenu）负责把它重新变回「毛玻璃」。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 实底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_popup_solid" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 顶部镜面高光 -->
    <item
        android:gravity="top"
        android:left="18dp"
        android:right="18dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/glass_highlight"
                android:endColor="@android:color/transparent"
                android:startColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- 棱边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
