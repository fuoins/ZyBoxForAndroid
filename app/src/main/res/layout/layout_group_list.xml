<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <!-- ZyBox 6.0: 顶栏 + 分组栏 一整块连续渐变（同一个 drawable，视觉上不再割裂） -->
    <LinearLayout
        android:id="@+id/zy_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_brand_gradient"
        android:elevation="4dp"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:theme="?actionBarTheme"
                android:touchscreenBlocksFocus="false"
                app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                app:title="@string/app_name"
                app:titleTextAppearance="@style/ZyBoxToolbarTitle" />
        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/group_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:tabBackground="@drawable/zybox_tab_bg"
            app:tabIndicator="@drawable/zybox_tab_indicator"
            app:tabIndicatorColor="?tabIndicatorColor"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabTextAppearance="@style/ZyBoxTabText"
            app:tabMode="scrollable"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?tabSelectedTextColor"
            app:tabTextColor="?tabTextColor"
            app:tabUnboundedRipple="false" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>