<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <io.nekohasekai.sagernet.widget.LiquidGlassButton
        android:id="@+id/debug_crash"
        style="@style/Widget.MaterialComponents.Button.ZyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crash From Kt"
        android:textColor="?whiteOrTextPrimary" />

    <io.nekohasekai.sagernet.widget.LiquidGlassButton
        android:id="@+id/reset_settings"
        style="@style/Widget.MaterialComponents.Button.ZyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Settings"
        android:textColor="?whiteOrTextPrimary" />

</LinearLayout>