<?xml version="1.0" encoding="utf-8"?>
<!-- ZyBox 首次初始化弹窗：进度 + 自动初始化/通知/VPN 三项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zybox_init_title"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/init_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/3"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="@color/material_pink_500" />
    </LinearLayout>

    <!-- 第 1 项：自动初始化 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/zybox_ping_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/init_status_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zybox_init_auto"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/init_btn_auto"
            style="@style/Widget.MaterialComponents.Button.ZyBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/zybox_init_start"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 第 2 项：通知权限 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/zybox_ping_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/init_status_notif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zybox_init_notif"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/init_btn_notif"
            style="@style/Widget.MaterialComponents.Button.ZyBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/zybox_init_grant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 第 3 项：VPN 权限 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/zybox_ping_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/init_status_vpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zybox_init_vpn"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/init_btn_vpn"
            style="@style/Widget.MaterialComponents.Button.ZyBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/zybox_init_grant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 进入按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/init_btn_enter"
        style="@style/Widget.MaterialComponents.Button.ZyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:text="@string/zybox_init_enter" />
</LinearLayout>
