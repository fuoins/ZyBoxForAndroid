<resources>
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- ZyBox UI 3.0：柔和浅色背景 -->
        <item name="android:windowBackground">@drawable/bg_gradient_mesh</item>
        <item name="android:colorBackground">@color/zybox_bg</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- ZyBox UI 3.0: 沉浸细节 —— 隐藏滚动条 / 去分隔线 / 去边缘光晕 -->
        <item name="android:scrollbarSize">0.0dip</item>
        <item name="android:listDivider">@null</item>
        <item name="android:colorEdgeEffect">@null</item>
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">@color/zybox_bg</item>
        <item name="colorPrimary">@color/zybox_primary</item>
        <item name="colorPrimaryDark">@color/zybox_primary_dark</item>
        <item name="colorAccent">@color/material_blue_accent_400</item>
        <!-- ZyBox UI 5.0: 柔白卡面，去死白劣质感 -->
        <item name="colorSurface">@color/zybox_surface</item>

        <item name="colorMaterial100">@color/material_blue_100</item>
        <item name="colorMaterial300">@color/material_blue_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/ZyBoxWindowAnimation</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView.ZyBox</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button.ZyBox</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.SagerNet.Medium
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">@color/zybox_bg</item>
        <item name="colorPrimary">@color/zybox_primary</item>
        <item name="colorPrimaryDark">@color/zybox_primary_dark</item>
        <item name="colorAccent">@color/material_blue_accent_400</item>
        <!-- ZyBox UI 5.0: 柔白卡面，去死白劣质感 -->
        <item name="colorSurface">@color/zybox_surface</item>

        <item name="colorMaterial100">@color/material_blue_100</item>
        <item name="colorMaterial300">@color/material_blue_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/ZyBoxWindowAnimation</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView.ZyBox</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button.ZyBox</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.SagerNet.Medium
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <!-- ZyBox UI 4.0: 全局 Activity 过渡动画 -->
    <style name="ZyBoxWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/zy_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/zy_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/zy_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/zy_activity_close_exit</item>
    </style>

    <style name="ShapeAppearance.SagerNet.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ZyBox UI 5.0: 卡片材质 —— 柔和阴影 + 大圆角，去纯色堆砌感 -->
    <style name="Widget.MaterialComponents.CardView.ZyBox" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">@color/zybox_card_stroke_soft</item>
    </style>

    <style name="Widget.MaterialComponents.Button.ZyBox" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.MaterialComponents.Button.ZyBox.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">@color/zybox_primary</item>
        <item name="android:textColor">@color/zybox_primary</item>
    </style>

    <!-- ZyBox: 紧凑按钮（单字/短标签，保证最小点击区 48dp） -->
    <style name="Widget.ZyBox.Button.Compact" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- ZyBox: 危险操作按钮（重置/崩溃测试，红色警示） -->
    <style name="Widget.ZyBox.Button.Danger" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorButtonNormal">@color/material_red_700</item>
        <item name="backgroundTint">@color/material_red_700</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ZyBox.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <!-- ZyBox UI 2.0：对话框大圆角 -->
    <style name="ShapeAppearance.ZyBox.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/zybox_corner_large</item>
    </style>

    <!-- ZyBox UI 2.0：Snackbar 大圆角 -->
    <style name="Widget.MaterialComponents.Snackbar.ZyBox" parent="Widget.MaterialComponents.Snackbar">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ZyBox.Snackbar</item>
    </style>

    <style name="ShapeAppearance.ZyBox.Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/zybox_corner</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">12dp</item>
        <item name="textEndPadding">12dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
        <item name="chipCornerRadius">@dimen/zybox_corner</item>
    </style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ZyBox: 分组 Tab 文字（选中加粗） -->
    <style name="ZyBoxTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ZyBox: 工具栏标题小字号，避免被右侧按钮挤成省略号 -->
    <style name="ZyBoxToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>