<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid Glass 设计系统 · 夜间
    同一套材质在暗环境中转为「烟熏玻璃」：极低透明度的白 + 冷灰光斑。
-->
<resources>

    <color name="glass_bg">#070910</color>
    <color name="glass_bg_deep">#04060A</color>
    <color name="glass_bg_veil">#0C1018</color>

    <color name="glass_glow_a">#24FFFFFF</color>
    <color name="glass_glow_b">#1A2A3B57</color>
    <color name="glass_glow_c">#12FFFFFF</color>
    <color name="glass_glow_d">#0F1B2A40</color>

    <color name="glass_surface">#1CFFFFFF</color>
    <color name="glass_surface_soft">#12FFFFFF</color>
    <color name="glass_surface_strong">#26FFFFFF</color>
    <color name="glass_surface_sunken">#1A0A0E16</color>
    <!-- 夜间同样要给足不透明度，玻璃感交给背景模糊 -->
    <color name="glass_popup_solid">#F70A0F17</color>
    <!-- Spinner 下拉：见 values/glass_colors.xml 同名注释 -->
    <color name="glass_popup_menu_solid">#990A0F17</color>

    <!--
        夜间的大块承重面板：不是「白色的低透明度」，而是**深色实底**。
        半透明白压在纯黑页面上会变成一层灰雾，字看不清、玻璃也没质感；
        用 92~96% 的深墨色，再由背景模糊提供「透」的感觉。
    -->
    <color name="glass_panel">#F00B1018</color>
    <color name="glass_panel_soft">#E6090D14</color>
    <color name="glass_dock_top">#F70C1119</color>
    <color name="glass_dock_bottom">#F20A0E15</color>
    <color name="glass_dialog_solid">#FA0A0F17</color>

    <color name="glass_stroke">#33FFFFFF</color>
    <color name="glass_stroke_outer">#4D000000</color>
    <color name="glass_highlight">#59FFFFFF</color>
    <color name="glass_highlight_soft">#24FFFFFF</color>
    <color name="glass_shadow">#66000000</color>
    <color name="glass_scrim">#6603050A</color>

    <color name="glass_text_primary">#F4F7FC</color>
    <color name="glass_text_secondary">#A6B0C0</color>
    <color name="glass_text_tertiary">#78828F</color>
    <color name="glass_text_inverse">#0A0F18</color>

    <color name="glass_accent">#EAF0FA</color>
    <color name="glass_accent_pressed">#CBD6E6</color>
    <color name="glass_accent_soft">#2EEAF0FA</color>
    <color name="glass_on_accent">#0A0F18</color>

    <!-- 按压水波纹：夜间用低透明度白（见 values/glass_colors.xml 同名注释） -->
    <color name="glass_ripple">#26FFFFFF</color>

    <color name="glass_success">#4CD39A</color>
    <color name="glass_warning">#E0AE5A</color>
    <color name="glass_danger">#E86A6E</color>

    <color name="fab_color_progress">@color/glass_highlight</color>
    <!-- 下拉项透明，露出弹窗自己的玻璃底（见 values/colors.xml 同名注释） -->
    <color name="preference_simple_menu_background">@android:color/transparent</color>

</resources>
